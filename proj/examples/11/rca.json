  "root-cause": {
    "cause": "NetworkPolicy/frontend-egress isolates app=api Pods but permits only DNS, omitting required backend egress on TCP 8080.",
    "causal_chain": "With an enforcing CNI and no additive allow rule, backend traffic from selected frontend Pods is denied while DNS and unrelated clients still work.",
    "supporting_evidence": [
      "The enforcing policy selects app=api and its egress rules allow only TCP/UDP 53.",
      "Service/backend endpoints and backend readiness are healthy, and frontend DNS lookup succeeds.",
      "A frontend TCP check to backend:8080 fails while the equivalent check from the unselected control client succeeds; review every additive policy."
    ],
    "remediation": "Restore the narrowly scoped backend TCP 8080 egress rule using app/.",
    "recovery_check": "Frontend-to-backend requests succeed with the policy still selecting the frontend and DNS continuing to work."
  }
